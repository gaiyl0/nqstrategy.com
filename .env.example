# Required in production. Generate at least 32 random characters, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional dedicated HMAC key for hashing IP/account identifiers in rate-limit
# buckets and audit logs. Falls back to JWT_SECRET when omitted.
AUDIT_HASH_SECRET=
# Required in production. Signs the append-only audit chain and archive manifests.
AUDIT_INTEGRITY_SECRET=
# Comma-separated old secrets kept only while records signed by them remain.
AUDIT_INTEGRITY_PREVIOUS_SECRETS=
AUDIT_RETENTION_DAYS=180
AUDIT_ARCHIVE_DIR=storage/audit-archives
# 可单独配置验证码 HMAC 密钥；未配置时复用 JWT_SECRET。生产环境至少 32 个字符。
VERIFICATION_CODE_SECRET=

# Required in production. The proxy must overwrite the selected IP header and
# inject X-Nexus-Proxy-Secret. Allowed: cloudflare, nginx, forwarded.
TRUSTED_PROXY_MODE=
TRUSTED_PROXY_SHARED_SECRET=

# The current SQLite rate limiter is supported only for one application
# instance sharing data.db. Production startup rejects any other declaration.
RATE_LIMIT_BACKEND=sqlite
DEPLOYMENT_TOPOLOGY=single-instance

# Exact public frontend origins, comma-separated and without trailing slashes.
# Production requires HTTPS. Browser state-changing API requests must match.
APP_ORIGINS=https://nexusquant.example
# Public canonical origin used by product metadata, sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://nexusquant.example
# Optional bearer token for non-browser maintenance/API automation.
CSRF_AUTOMATION_SECRET=

# Signs the immutable per-user wallet ledger. Preserve old keys until every
# signed transaction has passed its required retention period.
LEDGER_INTEGRITY_SECRET=
LEDGER_INTEGRITY_PREVIOUS_SECRETS=

# Signs short-lived EA authorization tokens and irreversibly hashes account/device bindings.
LICENSE_SIGNING_SECRET=
LICENSE_BINDING_SECRET=

# Production uploads fail closed unless this malware scanning endpoint returns
# JSON {"clean":true}. The service receives raw file bytes and metadata headers.
UPLOAD_SCAN_URL=
UPLOAD_SCAN_TOKEN=

# Paid checkout is intentionally disabled in code. Do not enable real-money
# sales until every payment gate in GO_LIVE_CHECKLIST.md has passed.
# MT5 evidence screenshots remain private; configure an OCR adapter that returns
# {"fields": {...}, "confidence": 0..1}. Missing/unavailable OCR forces manual review.
NEXUS_EVIDENCE_ROOT=
NEXUS_REPORT_ROOT=
# Production refuses pending migrations by default. Run `npm run db:migrate -- up`
# before starting the new release. Set this to 1 only for an explicitly supervised
# one-process build or recovery run where automatic migration is intended.
NEXUS_AUTO_MIGRATE=0
EVIDENCE_OCR_URL=
EVIDENCE_OCR_TOKEN=
