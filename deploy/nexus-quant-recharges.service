[Unit]
Description=Nexus Quant verified recharge reconciliation
After=network-online.target nexus-quant.service
Wants=network-online.target
ConditionPathExists=/opt/nexus-quant/current/scripts/reconcile-recharges.mjs

[Service]
Type=oneshot
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus-quant/current
EnvironmentFile=/etc/nexus-quant/nexus.env
Environment=NODE_ENV=production
ExecStart=/bin/bash -c 'exec 9</var/lock/nexus-quant-deploy.lock; flock -s -n 9 || exit 0; exec /usr/bin/node scripts/reconcile-recharges.mjs'
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
